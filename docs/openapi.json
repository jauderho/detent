  "components": {
    "schemas": {
      "ApiServiceCommand": {
        "type": "string",
        "description": "A [`ServiceCommand`](detent_ops::ServiceCommand), as a request body may\nname it.\n\n[`detent_ops::ServiceCommand`] cannot derive [`utoipa::ToSchema`] without\ngiving `detent-ops` a dependency on `utoipa`, which PLAN §2.1 forbids: the\noperations layer stays front-end agnostic. This is the thin mirror that\nlets a request body have a precise, documented schema anyway; it converts\nstraight to the real type and carries no behaviour of its own.",
        "enum": [
          "restart",
          "reload",
          "start",
          "stop"
        ]
      },
      "ApplyRequest": {
        "type": "object",
        "description": "The body of `POST /api/v1/modules/{id}/apply`.",
        "required": [
          "model"
        ],
        "properties": {
          "confirm_secs": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Commit-confirm window, in seconds. Omitted uses the module's default;\nthe monitor clamps whatever is armed either way.",
            "minimum": 0
          },
          "expected_hash": {
            "type": [
              "string",
              "null"
            ],
            "description": "Digest the caller last read, as 64 lowercase hex characters. A\nmismatch is refused (409) rather than silently overwriting somebody\nelse's edit.",
            "maxLength": 64
          },
          "model": {
            "type": "object",
            "description": "The candidate model."
          },
          "service_action": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ApiServiceCommand",
                "description": "What to do to the module's service afterwards."
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "CommitConfirmedView": {
        "type": "object",
        "description": "Answer to `ConfirmCommit`.",
        "required": [
          "commit_id"
        ],
        "properties": {
          "commit_id": {
            "type": "integer",
            "format": "int32",
            "description": "The commit that is now final.",
            "minimum": 0
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "The JSON body of every API failure.",
        "required": [
          "code",
          "message_id"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "A stable machine-readable class, derived from the status."
          },
          "diagnostics": {
            "type": "object",
            "description": "Validation findings, only present for a rejected [`Operation::Apply`]\n(PLAN §2.5: any `Severity::Error` diagnostic stops an apply before\nanything is written). Mirrors `detent_core::diag::Diagnostics`, which\ncannot derive `ToSchema` without giving `detent-core` a dependency on\n`utoipa`.\n\n[`Operation::Apply`]: detent_ops::Operation::Apply"
          },
          "message_id": {
            "type": "string",
            "description": "The Fluent id a front end renders."
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "description": "The body of `POST /api/v1/auth/login`.",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "description": "The password, in the clear over TLS 1.3 and nowhere else."
          },
          "totp_code": {
            "type": [
              "string",
              "null"
            ],
            "description": "The six-digit TOTP code, when the account has a second factor enrolled\nor `auth.totp_required` is set."
          },
          "username": {
            "type": "string",
            "description": "The account name."
          }
        },
        "additionalProperties": false
      },
      "ModelRequest": {
        "type": "object",
        "description": "The body of `POST /api/v1/modules/{id}/validate` and `.../plan`.",
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "object",
            "description": "The candidate model, exactly as the shape `GET /modules/{id}`'s\n`schema` field describes."
          }
        },
        "additionalProperties": false
      },
      "RestoredView": {
        "type": "object",
        "description": "Answer to `Restore`.",
        "required": [
          "target",
          "new_hash"
        ],
        "properties": {
          "new_hash": {
            "type": "string",
            "description": "Digest now on disk, 64 lowercase hex characters."
          },
          "target": {
            "type": "integer",
            "format": "int32",
            "description": "The target that was put back, as the monitor's index for it.",
            "minimum": 0
          }
        }
      },
      "RolledBackView": {
        "type": "object",
        "description": "Answer to `RollbackCommit`.",
        "required": [
          "commit_id",
          "restored"
        ],
        "properties": {
          "commit_id": {
            "type": "integer",
            "format": "int32",
            "description": "The commit that was rolled back.",
            "minimum": 0
          },
          "restored": {
            "type": "integer",
            "format": "int32",
            "description": "How many targets were actually restored.",
            "minimum": 0
          }
        }
      },
      "ServiceActionRequest": {
        "type": "object",
        "description": "The body of `POST /api/v1/services/{id}`.",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "$ref": "#/components/schemas/ApiServiceCommand",
            "description": "What to do."
          }
        },
        "additionalProperties": false
      },
      "SessionView": {
        "type": "object",
        "description": "What `GET /api/v1/auth/session` answers.\n\nThe session **id** is deliberately absent: the browser already holds it in\na `HttpOnly` cookie, and a copy of it in a readable response body would\nundo that.",
        "required": [
          "subject",
          "scopes",
          "csrf_token",
          "expires_in_secs",
          "totp_satisfied"
        ],
        "properties": {
          "csrf_token": {
            "type": "string",
            "description": "The token to echo in `X-Detent-CSRF`."
          },
          "expires_in_secs": {
            "type": "integer",
            "format": "int64",
            "description": "Seconds until the session expires, idle and absolute limits combined.",
            "minimum": 0
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Scope names, `[\"read\"]` or `[\"read\", \"write\"]`."
          },
          "subject": {
            "type": "string",
            "description": "The user this session belongs to."
          },
          "totp_satisfied": {
            "type": "boolean",
            "description": "Whether a second factor was presented."
          }
        }
      }
