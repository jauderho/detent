{
  "openapi": "3.1.0",
  "info": {
    "title": "detent API",
    "description": "PLAN §2.6/§2.7: the detent-web `/api/v1` surface.",
    "license": {
      "name": "BSD-3-Clause",
      "identifier": "BSD-3-Clause"
    },
    "version": "0.0.1"
  },
  "paths": {
    "/api/v1/audit": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "`GET /api/v1/audit`.",
        "description": "Response body mirrors `Vec<detent_ops::audit::AuditRecord>`.",
        "operationId": "audit",
        "parameters": [
          {
            "name": "module",
            "in": "query",
            "description": "Only records about this module. At most [`MAX_FILTER_LEN`] bytes.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "who",
            "in": "query",
            "description": "Only records from this subject. At most [`MAX_FILTER_LEN`] bytes.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "At most this many records, newest first, capped at\n[`MAX_AUDIT_LIMIT`].",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching audit records, newest first",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "`POST /api/v1/auth/login`. The real handler is `crate::auth::routes::login`.",
        "operationId": "login_doc",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in; the session cookie is set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionView"
                }
              }
            }
          },
          "401": {
            "description": "The credentials were refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "`POST /api/v1/auth/logout`. The real handler is `crate::auth::routes::logout`.",
        "operationId": "logout_doc",
        "responses": {
          "204": {
            "description": "Session ended; the cookie is cleared"
          },
          "401": {
            "description": "No session to end",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "`GET /api/v1/auth/session`. The real handler is `crate::auth::routes::session`.",
        "operationId": "session_doc",
        "responses": {
          "200": {
            "description": "The current session's CSRF token, scopes and expiry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionView"
                }
              }
            }
          },
          "401": {
            "description": "No session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/commits/{id}/confirm": {
      "post": {
        "tags": [
          "commits"
        ],
        "summary": "`POST /api/v1/commits/{id}/confirm`.",
        "operationId": "confirm",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Commit id `Apply` returned",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The commit is now final",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommitConfirmedView"
                }
              }
            }
          },
          "409": {
            "description": "No such commit is pending",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/commits/{id}/rollback": {
      "post": {
        "tags": [
          "commits"
        ],
        "summary": "`POST /api/v1/commits/{id}/rollback`.",
        "operationId": "rollback",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Commit id `Apply` returned",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Every write since the commit was armed is undone",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RolledBackView"
                }
              }
            }
          },
          "409": {
            "description": "No such commit is pending",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
