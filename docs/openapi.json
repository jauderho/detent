    "/api/v1/modules/{id}/apply": {
      "post": {
        "tags": [
          "modules"
        ],
        "summary": "`POST /api/v1/modules/{id}/apply`.",
        "description": "Response body mirrors `detent_ops::report::ApplyReport`.",
        "operationId": "apply",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Module id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "What was written, and any service action or commit-confirm window",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "No such module",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "The target changed since `expected_hash` was read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "The candidate has at least one error diagnostic",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
