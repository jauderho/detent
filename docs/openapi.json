    "/healthz": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "`GET /healthz`. The real handler is `crate::server::healthz`.",
        "operationId": "healthz_doc",
        "responses": {
          "200": {
            "description": "The process is serving",
