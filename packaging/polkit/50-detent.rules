// packaging/polkit/50-detent.rules
//
// Used only in the "capability-user" privilege mode (PLAN §2.4, Phase 12).
// In that mode the whole service runs as the unprivileged `detent` user, so
// its runner's `systemctl` calls go through polkit. This rule grants the
// `detent` user exactly what the runner asks for, and nothing else:
//
//   1. org.freedesktop.systemd1.manage-units for the units that tier-1
//      modules bind services to, each with only the verbs its module binding
//      allows (ServiceBinding.actions in the module descriptors).
//   2. org.freedesktop.systemd1.manage-units "start" and "stop" of
//      .mount/.automount units, for `[mounts] activate_new_entries` (Track D
//      1, D1 mount route). polkit cannot see which units detent itself
//      started, so every mount unit is allowed except the ones over the paths
//      the runner also protects: `/` and every ancestor of /etc, /usr,
//      /boot, the state root /var/lib/detent and the binary directory
//      /usr/local/bin. The runner itself stops only the units it recorded.
//   3. org.freedesktop.systemd1.reload-daemon (`systemctl daemon-reload`
//      after an fstab write; systemd gives this action no details).
//   4. org.freedesktop.systemd1.manage-units "start" (only start) of an
//      instance of the packaged template unit detent-update@.service whose
//      instance name has the shape of a release tag, for the web and MCP
//      update install (E16). The template runs only
//      `/usr/local/bin/detent update --tag=%i` as root; the updater verifies
//      the release and refuses a downgrade. polkit sees only the unit name
//      and verb, also for a transient unit (systemd-run), so this grant is
//      safe only while /etc/systemd/system/detent-update@.service exists:
//      systemd then refuses a transient unit of an instance name ("has a
//      fragment file"). The rule checks that the file exists before it
//      grants; install.sh also installs the template before this rule and
//      removes this rule first.
//
// Installed to /etc/polkit-1/rules.d/50-detent.rules by
// `install.sh --mode capability-user` only. JavaScript rules need polkit
// 0.106 or later.

polkit.addRule(function (action, subject) {
  if (subject.user != "detent") {
    return polkit.Result.NOT_HANDLED;
  }

  if (action.id == "org.freedesktop.systemd1.reload-daemon") {
    return polkit.Result.YES;
  }
  if (action.id != "org.freedesktop.systemd1.manage-units") {
    return polkit.Result.NOT_HANDLED;
  }

  var unit = action.lookup("unit");
  var verb = action.lookup("verb");
  if (typeof unit !== "string" || typeof verb !== "string") {
    return polkit.Result.NOT_HANDLED;
  }

  // Unit -> verbs, from the module descriptors' service bindings.
  var UNIT_VERBS = {
    "NetworkManager.service": ["reload", "restart"],
    "chrony.service": ["reload", "restart"],
    "chronyd.service": ["reload", "restart"],
    "dnsmasq.service": ["reload", "restart"],
    "kea-dhcp4-server.service": ["restart"],
    "kea-dhcp6-server.service": ["restart"],
    "networking.service": ["reload", "restart"],
    "nfs-server.service": ["reload", "restart"],
    "samba.service": ["reload", "restart"],
    "smb.service": ["reload", "restart"],
    "systemd-networkd.service": ["reload", "restart"],
    "systemd-resolved.service": ["restart"],
    "unbound.service": ["reload", "restart"],
  };
  if (Object.prototype.hasOwnProperty.call(UNIT_VERBS, unit)) {
    return UNIT_VERBS[unit].indexOf(verb) !== -1
      ? polkit.Result.YES
      : polkit.Result.NOT_HANDLED;
  }

  // Instances of the update template unit: start only, and only a name of
  // the shape of a release tag (`proto::is_release_tag`: `v`, then only
  // [0-9A-Za-z.-], at most 64 bytes); no `\` escape.
  var UPDATE_UNIT = /^detent-update@v[0-9A-Za-z.-]{1,63}\.service$/;
  var UPDATE_TEMPLATE = "/etc/systemd/system/detent-update@.service";
  if (UPDATE_UNIT.test(unit)) {
    if (verb != "start") {
      return polkit.Result.NOT_HANDLED;
    }
    // Only while the template file exists: without it systemd accepts a
    // transient unit of this name, and polkit cannot tell the two apart.
    try {
      polkit.spawn(["/usr/bin/test", "-f", UPDATE_TEMPLATE]);
    } catch (error) {
      return polkit.Result.NOT_HANDLED;
    }
    return polkit.Result.YES;
  }

  // Mount units of fstab entries: what `systemd-escape --path` writes, never
  // the root mount ("-.mount") or a mount over a protected path.
  var MOUNT_UNIT = /^[A-Za-z0-9:_.\\][A-Za-z0-9:_.\\-]*\.(mount|automount)$/;
  var PROTECTED_MOUNT_UNITS = [
    "boot.automount",
    "boot.mount",
    "etc.automount",
    "etc.mount",
    "usr-local-bin.automount",
    "usr-local-bin.mount",
    "usr-local.automount",
    "usr-local.mount",
    "usr.automount",
    "usr.mount",
    "var-lib-detent.automount",
    "var-lib-detent.mount",
    "var-lib.automount",
    "var-lib.mount",
    "var.automount",
    "var.mount",
  ];
  if (
    MOUNT_UNIT.test(unit) &&
    PROTECTED_MOUNT_UNITS.indexOf(unit) === -1 &&
    (verb == "start" || verb == "stop")
  ) {
    return polkit.Result.YES;
  }

  return polkit.Result.NOT_HANDLED;
});
