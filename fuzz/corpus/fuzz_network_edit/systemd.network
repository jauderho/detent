# /etc/systemd/network/10-eth0.network — stock systemd 261.3 example
# See systemd.network(5). The modeled subset is [Match]/[Network]/[Address]/[Route]/[VLAN].
[Match]
Name=eth0

[Network]
DHCP=yes
DNS=192.168.1.1
DNS=2001:db8::1

[Address]
Address=192.168.1.10/24

[Route]
Destination=10.0.0.0/24
Gateway=192.168.1.1

[VLAN]
Id=100
