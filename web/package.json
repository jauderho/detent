{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun scripts/gen-pseudo.ts && tsc -b && vite build && bun scripts/build-finish.ts",
    "preview": "vite preview",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "test": "bun scripts/gen-pseudo.ts && bun test",
    "i18n:check": "bun scripts/i18n-check.ts",
    "i18n:pseudo": "bun scripts/gen-pseudo.ts",
    "contrast:check": "bun scripts/contrast-check.ts",
    "typecheck": "tsc -b --force",
    "api:generate": "openapi-typescript ../docs/openapi.json -o src/api/schema.d.ts",
    "api:check": "bun scripts/api-check.ts",
    "build:finish": "bun scripts/build-finish.ts",
    "test:coverage": "bun test --coverage",
    "coverage:check": "bun scripts/coverage-check.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fluent/bundle": "0.19.1",
    "@fluent/react": "0.15.2",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.10",
    "@happy-dom/global-registrator": "20.14.3",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/bun": "1.4.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "lightningcss": "1.33.0",
    "openapi-typescript": "7.13.0",
    "terser": "5.51.2",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  }
}
